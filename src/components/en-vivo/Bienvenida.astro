---
import { Image } from "astro:assets";
import Seccion from "../ui/Seccion.astro";
import portada from "@pack/imagenes/envivo-portada.jpg";
---

<Seccion id="bienvenida">
  <div class="mx-auto grid max-w-7xl items-center gap-8 md:grid-cols-2">
    <div class="text-center md:text-left">
      <p class="text-sm font-bold tracking-[0.2em] text-marca uppercase">Misión Mundial</p><h1
        class="mt-3 text-3xl font-bold tracking-tight md:text-5xl"
        data-revelar
      >
        Conéctate desde donde estés.
      </h1><p class="mt-5 text-texto-suave" data-revelar>
        La distancia no es un impedimento para compartir nuestra fe. Acompáñanos en las
        transmisiones de Misión Mundial y sé parte de nuestros cultos desde donde te encuentres.
      </p>
    </div>
    <div class="overflow-hidden rounded-marca shadow-marca" data-revelar>
      <Image
        src={portada}
        alt="Fotografía de una transmisión y encuentro de Misión Mundial"
        class="h-64 w-full object-cover sm:h-80"
      />
    </div>
  </div>
</Seccion>
