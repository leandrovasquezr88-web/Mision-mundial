---
import Seccion from "../ui/Seccion.astro";
---

<Seccion id="proximo-culto" titulo="Nuestra próxima transmisión.">
  <div
    class="mx-auto max-w-3xl rounded-marca bg-superficie p-8 text-center shadow-marca borde-marca"
    data-revelar
  >
    <p class="text-lg font-semibold">Próximo culto por anunciar</p>
    <p class="mt-3 text-texto-suave">
      La fecha, el horario y el enlace de la próxima transmisión se publicarán aquí cuando estén
      confirmados.
    </p>
  </div>
</Seccion>
