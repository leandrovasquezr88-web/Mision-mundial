---
import Seccion from "../ui/Seccion.astro";
import Boton from "../ui/Boton.astro";
import { sitio } from "../../datos/sitio";
---

<Seccion id="horarios" titulo="Horarios de transmisión.">
  <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2">
    <div class="rounded-marca bg-superficie p-6 shadow-marca borde-marca" data-revelar>
      <h3 class="text-xl font-bold">Cultos transmitidos</h3>
      <p class="mt-3 text-texto-suave">
        Nuestro culto general se realiza los domingos a las 9:30 a. m. Las transmisiones en vivo se
        anunciarán en nuestra página oficial de Facebook.
      </p>
    </div>
    <div class="rounded-marca bg-superficie p-6 shadow-marca borde-marca" data-revelar>
      <h3 class="text-xl font-bold">Transmisiones especiales</h3>
      <p class="mt-3 text-texto-suave">
        Consulta nuestra programación de eventos para conocer las próximas transmisiones especiales.
      </p>
      <div class="mt-5">
        <Boton href="/eventos" variante="secundario">Ver próximos eventos</Boton>
      </div>
    </div>
  </div>
</Seccion>
