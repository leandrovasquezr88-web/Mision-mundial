---
import { Image } from "astro:assets";
import Seccion from "../ui/Seccion.astro";
import portada from "@pack/imagenes/eventos-portada.jpg";
import jovenes from "@pack/imagenes/eventos-jovenes.jpg";
import congresos from "@pack/imagenes/eventos-congresos.jpg";
import reuniones from "@pack/imagenes/eventos-reuniones.jpg";
---

<Seccion id="presentacion">
  <div class="mx-auto max-w-7xl">
    <div class="grid items-center gap-7 md:grid-cols-[1.15fr_0.85fr]">
      <div class="overflow-hidden rounded-marca shadow-marca" data-revelar>
        <Image
          src={portada}
          alt="Fotografía panorámica de un encuentro de Misión Mundial"
          class="h-72 w-full object-cover md:h-[430px]"
        />
      </div>
      <div class="text-center md:text-left">
        <p class="text-sm font-bold tracking-[0.2em] text-marca uppercase">
          Fe · Comunidad · Encuentros
        </p><h1 class="mt-3 text-3xl font-bold tracking-tight md:text-5xl" data-revelar>
          Vive nuestros eventos.
        </h1><p class="mt-5 text-texto-suave" data-revelar>
          En Misión Mundial compartimos momentos especiales de fe, adoración y comunidad. Descubre
          nuestras próximas actividades y sé parte de cada experiencia.
        </p>
      </div>
    </div>
    <div class="mt-7 grid grid-cols-3 gap-3 md:gap-5" data-revelar-cascada>
      <Image
        src={jovenes}
        alt="Actividad de jóvenes de Misión Mundial"
        class="h-28 w-full rounded-marca object-cover sm:h-44"
      />
      <Image
        src={congresos}
        alt="Congreso y encuentro de Misión Mundial"
        class="h-28 w-full rounded-marca object-cover sm:h-44"
      />
      <Image
        src={reuniones}
        alt="Reunión de la congregación de Misión Mundial"
        class="h-28 w-full rounded-marca object-cover sm:h-44"
      />
    </div>
  </div>
</Seccion>
