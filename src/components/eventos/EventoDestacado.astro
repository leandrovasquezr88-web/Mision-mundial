---
import Seccion from "../ui/Seccion.astro";
import Boton from "../ui/Boton.astro";
---

<Seccion id="evento-destacado" titulo="Un nuevo encuentro se está preparando.">
  <div
    class="mx-auto max-w-5xl overflow-hidden rounded-marca border border-borde bg-superficie shadow-marca"
    data-revelar
  >
    <div class="grid md:grid-cols-[0.9fr_1.1fr]">
      <div
        class="flex min-h-64 flex-col items-center justify-center bg-marca p-8 text-center text-marca-contraste md:min-h-[390px]"
      >
        <span class="text-sm font-bold tracking-[0.2em] uppercase">Misión Mundial</span>
        <span class="mt-6 text-6xl" aria-hidden="true">✦</span>
        <p class="mt-5 font-titulos text-3xl font-bold">Próximamente</p>
        <p class="mt-2 text-sm opacity-90">Estamos preparando algo especial</p>
      </div>
      <div class="flex flex-col justify-center p-7 md:p-10">
        <p class="text-sm font-bold tracking-widest text-marca uppercase">Próximo encuentro</p>
        <h3 class="mt-3 font-titulos text-2xl font-bold md:text-3xl">
          ¡Queremos volver a encontrarnos!
        </h3>
        <p class="mt-4 leading-relaxed text-texto-suave">
          Estamos preparando nuestra próxima actividad para compartir como comunidad. Muy pronto
          anunciaremos todos los detalles.
        </p>
        <dl class="mt-6 space-y-3 text-sm">
          <div class="flex justify-between gap-4 border-b border-borde pb-2">
            <dt class="font-bold">Actividad</dt><dd class="text-right text-texto-suave">
              Por definir
            </dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-borde pb-2">
            <dt class="font-bold">Fecha y hora</dt><dd class="text-right text-texto-suave">
              Por confirmar
            </dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="font-bold">Lugar</dt><dd class="text-right text-texto-suave">
              Por confirmar
            </dd>
          </div>
        </dl>
        <div class="mt-7">
          <Boton href="/contacto#canales-contacto" variante="secundario"
            >Consultar por nuestros canales</Boton>
        </div>
      </div>
    </div>
  </div>
</Seccion>
